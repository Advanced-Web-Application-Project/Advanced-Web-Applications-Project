PORT=3000
FRONTEND_URL=http://localhost:5173
# Replace with credentials for your isolated development database.
DATABASE_URL=postgresql://rio_dev:replace-me@127.0.0.1:5432/rio_dev
# Temporary convention for the current timezone-less schema.
TZ=Europe/Helsinki
# Required only by commands that write isolated development data.
RIO_DATABASE_MODE=isolated-development
# TMDB API Read Access Token (v4 Bearer token, server/local CLI only).
# Never commit real tokens, place them in URLs, store them in PostgreSQL, or expose them to the browser.
TMDB_API_READ_ACCESS_TOKEN=
# Optional per-request TMDB timeout (1000–30000 ms; default 8000).
TMDB_TIMEOUT_MS=8000

# Optional staff API: set BOTH origin and private secret to enable it.
# Local browser/API must use the same hostname (e.g. 127.0.0.1 ports 5174/3000).
STAFF_FRONTEND_URL=
# Generate a random 32-byte canonical base64url value directly into ignored .env.
# See docs/API-STAFF-AUTH.md. Never print or commit a real secret.
STAFF_SESSION_SECRET=
# 0 locally; 1 only after verifying one trusted ingress hop and header sanitization.
STAFF_TRUST_PROXY_HOPS=0

# Optional customer sign-in and registration.
# Use a separate private random 32-byte canonical base64url secret.
CUSTOMER_SESSION_SECRET=
# 0 locally; use 1 only for the verified trusted ingress boundary.
CUSTOMER_TRUST_PROXY_HOPS=0
