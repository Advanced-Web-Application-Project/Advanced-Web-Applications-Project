@baseUrl = http://localhost:3000
//API TESTS

### 1. GET ALL FILMS
GET {{baseUrl}}/api/films

### GET FILM BY ID
GET {{baseUrl}}/api/films/1



### GET CITIES
GET {{baseUrl}}/api/cities

### GET CITY BY ID
GET {{baseUrl}}/api/cities/1



### GET SCREEN BY ID
GET {{baseUrl}}/api/screens/1

### GET ALL SCREENS
GET {{baseUrl}}/api/screens



### GET SEATS FROM SCREEN ID 1 AND SCREENING ID 1
GET {{baseUrl}}/api/seats?screenId=1&screeningId=1

### GET SEATS FROM SCREEN ID 1
GET {{baseUrl}}/api/seats?screenId=1



### GET ALL SCREENINGS
GET {{baseUrl}}/api/screenings

### GET SCREENINGS BY CITY id
GET {{baseUrl}}/api/screenings?cityId=1



### GET PRICES
GET {{baseUrl}}/api/prices




### Post A NEW BOOKING 
POST {{baseUrl}}/api/bookings
Content-Type: application/json

{
    "screeningId": 1,
    "seatId": [12],
    "clientEmail": "test@client.com"
}

### Post a new booking with different ages
POST http://localhost:3000/api/bookings
Content-Type: application/json

{
  "screeningId": 1,
  "seatId": [
    { "seatId": 12, "category": "adult" },
    { "seatId": 14, "category": "child" }
  ],
  "clientEmail": "perhe.matkustaja@example.com"
}

### GET BOOKINGS WITH SCREENING FILTER
GET {{baseUrl}}/api/bookings?screeningId=1

### GET ALL BOOKINGS 
GET {{baseUrl}}/api/bookings

### DELETE BOOKING BY ID 
DELETE {{baseUrl}}/api/bookings/28


### 4. INVALID TEST MISSING seatID (returns 400)
POST http://localhost:3000/api/bookings
Content-Type: application/json

{
  "screeningId": 1,
  "seatId": []
}



### SCREENINGS BY SCREEN (use IDs returned by the city/screen/film APIs)
GET {{baseUrl}}/api/screenings?screenId=1

### SCREENINGS BY CITY, SCREEN AND FILM (filters combine with AND)
GET {{baseUrl}}/api/screenings?cityId=1&screenId=1&filmId=1

### INVALID SCREEN FILTER (expected 400)
GET {{baseUrl}}/api/screenings?screenId=1.5

